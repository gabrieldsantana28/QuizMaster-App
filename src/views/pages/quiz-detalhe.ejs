<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title><%= title %> — QuizMaster</title><link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
<div class="page-wrapper">
  <nav class="navbar">
    <a href="/feed" class="navbar-brand">🎯 QuizMaster</a>
    <div class="navbar-nav">
      <a href="/feed">Explorar</a>
      <a href="/quiz/criar">+ Criar Quiz</a>
      <a href="/favoritos">❤️ Favoritos</a>
      <a href="/logout">Sair</a>
    </div>
  </nav>
  <% if(messages && messages.success && messages.success.length){ %><div class="alert alert-success">✅ <%= messages.success[0] %></div><% } %>
  <% if(messages && messages.error && messages.error.length){ %><div class="alert alert-danger">⚠️ <%= messages.error[0] %></div><% } %>
  <div style="max-width:760px;margin:0 auto">
    <div class="card mb-4">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px">
        <div>
          <h1 style="font-size:1.8rem;color:var(--blue-light);margin-bottom:8px"><%= quiz.titulo %></h1>
          <p style="color:var(--text-muted);margin-bottom:14px"><%= quiz.descricao || 'Sem descrição.' %></p>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <span class="badge badge-blue">Tema #<%= quiz.temaId %></span>
            <span class="badge <%= quiz.dificuldade==='facil'?'badge-green':quiz.dificuldade==='medio'?'badge-yellow':'badge-red' %>"><%= quiz.dificuldade %></span>
            <span style="color:var(--text-dim);font-size:.85rem">👥 <%= quiz.totalParticipantes || 0 %> jogadores</span>
          </div>
        </div>
        <form method="POST" action="/quiz/<%= quiz.id %>/favoritar" style="flex-shrink:0">
          <button type="submit" class="btn btn-secondary btn-sm">❤️ Favoritar</button>
        </form>
      </div>
    </div>
    <div class="card mb-4">
      <h2 class="section-title">🎮 Jogar Quiz</h2>
      <p style="color:var(--text-muted);margin-bottom:16px">Responda às questões deste quiz e veja se você acerta!</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="/quizzes/<%= quiz.id %>/questoes" class="btn btn-primary btn-sm">📋 Ver Questões</a>
        <% if(user && user.id === quiz.autorId){ %>
        <a href="/quizzes/<%= quiz.id %>/questoes/nova" class="btn btn-secondary btn-sm">+ Adicionar Questão</a>
        <% } %>
        <a href="/feed" class="btn btn-secondary btn-sm">← Voltar ao Feed</a>
      </div>
    </div>
    <div class="card mb-4">
      <h2 class="section-title">⭐ Avaliar este Quiz</h2>
      <form method="POST" action="/quiz/<%= quiz.id %>/avaliar">
        <div class="form-group">
          <label>Nota (1 a 5)</label>
          <select name="nota" style="width:auto;padding:9px 14px">
            <% for(let i=1;i<=5;i++){ %><option value="<%= i %>"><%= i %> estrela<%= i>1?'s':'' %></option><% } %>
          </select>
        </div>
        <div class="form-group">
          <label>Comentário (opcional)</label>
          <textarea name="comentario" placeholder="O que você achou deste quiz?"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Enviar Avaliação</button>
      </form>
    </div>
    <% if(avaliacoes && avaliacoes.length){ %>
    <div class="card">
      <h2 class="section-title">💬 Avaliações (<%= avaliacoes.length %>)</h2>
      <% avaliacoes.forEach(a=>{ %>
      <div style="padding:14px 0;border-bottom:1px solid var(--border)">
        <div class="stars"><% for(let i=0;i<a.nota;i++){ %>⭐<% } %> <span style="color:var(--text-dim);font-size:.85rem">(<%= a.nota %>/5)</span></div>
        <% if(a.comentario){ %><p style="color:var(--text-muted);margin-top:6px;font-size:.9rem"><%= a.comentario %></p><% } %>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>
</body></html>