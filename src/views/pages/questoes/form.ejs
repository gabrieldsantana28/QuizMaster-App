<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title><%= title %> — QuizMaster</title><link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
<div class="page-wrapper">
  <nav class="navbar">
    <a href="/feed" class="navbar-brand">🎯 QuizMaster</a>
    <div class="navbar-nav">
      <a href="/feed">Explorar</a>
      <a href="/quiz/criar">+ Criar Quiz</a>
      <a href="/favoritos">❤️ Favoritos</a>
      <a href="/logout">Sair</a>
    </div>
  </nav>
  <div class="form-card" style="max-width:680px">
    <h1 class="form-title">❓ <%= questao ? 'Editar' : 'Nova' %> Questão</h1>
    <p class="form-subtitle">Quiz: <%= quiz ? quiz.titulo : '#' + (questao ? questao.quizId : '') %></p>

    <% if(messages && messages.error && messages.error.length){ %>
      <div class="alert alert-danger">⚠️ <%= messages.error[0] %></div>
    <% } %>
    <% if(typeof errors !== 'undefined' && errors.length){ %>
      <div class="alert alert-danger"><% errors.forEach(e=>{ %><div>⚠️ <%= e %></div><% }) %></div>
    <% } %>

    <form method="POST" action="<%= questao ? `/questoes/${questao.id}/editar` : '/questoes' %>" id="questao-form">
      <input type="hidden" name="quizId" value="<%= questao ? questao.quizId : (quiz ? quiz.id : '') %>"/>

      <div class="form-group">
        <label>Enunciado * (mínimo 10 caracteres)</label>
        <textarea name="enunciado" required minlength="10" placeholder="Digite a pergunta..."><%= questao ? questao.enunciado : '' %></textarea>
      </div>

      <div class="form-group">
        <label>Alternativas * (entre 2 e 5)</label>
        <div id="alternativas-list" style="display:flex;flex-direction:column;gap:10px">
          <% alternativasAtuais.forEach((alt, idx)=>{ %>
          <div class="form-row" style="grid-template-columns:auto 1fr auto;align-items:center">
            <input type="radio" name="alternativaCorreta" value="<%= idx %>" class="alt-radio"
              <%= (questao && questao.alternativaCorreta === idx) ? 'checked' : (!questao && idx===0 ? 'checked' : '') %> required/>
            <input type="text" name="alternativas" value="<%= alt %>" placeholder="Alternativa <%= idx+1 %>" required/>
            <button type="button" class="btn btn-danger btn-sm remove-alt" <%= alternativasAtuais.length<=2 ? 'style="visibility:hidden"' : '' %>>✕</button>
          </div>
          <% }) %>
        </div>
        <button type="button" id="add-alt" class="btn btn-secondary btn-sm mt-4">+ Adicionar alternativa</button>
        <p style="color:var(--text-dim);font-size:.8rem;margin-top:8px">Marque o círculo da alternativa correta.</p>
      </div>

      <div class="form-group">
        <label>Dica (opcional, exibida quando o jogador erra)</label>
        <input type="text" name="dica" value="<%= questao && questao.dica ? questao.dica : '' %>" placeholder="Ex: Pense na capital europeia..."/>
      </div>

      <div style="display:flex;gap:12px;margin-top:8px">
        <button type="submit" class="btn btn-primary">💾 Salvar Questão</button>
        <a href="<%= quiz ? `/quizzes/${quiz.id}/questoes` : (questao ? `/quizzes/${questao.quizId}/questoes` : '/feed') %>" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<script>
  const list = document.getElementById('alternativas-list');
  const addBtn = document.getElementById('add-alt');
  const MAX_ALT = 5;
  const MIN_ALT = 2;

  function updateRemoveVisibility() {
    const rows = list.querySelectorAll('.form-row');
    rows.forEach(row => {
      const removeBtn = row.querySelector('.remove-alt');
      removeBtn.style.visibility = rows.length <= MIN_ALT ? 'hidden' : 'visible';
    });
    addBtn.style.display = rows.length >= MAX_ALT ? 'none' : 'inline-flex';
  }

  function attachRemoveHandler(btn) {
    btn.addEventListener('click', () => {
      if (list.querySelectorAll('.form-row').length > MIN_ALT) {
        btn.closest('.form-row').remove();
        updateRemoveVisibility();
      }
    });
  }

  list.querySelectorAll('.remove-alt').forEach(attachRemoveHandler);

  addBtn.addEventListener('click', () => {
    const rows = list.querySelectorAll('.form-row');
    if (rows.length >= MAX_ALT) return;
    const idx = rows.length;
    const row = document.createElement('div');
    row.className = 'form-row';
    row.style.gridTemplateColumns = 'auto 1fr auto';
    row.style.alignItems = 'center';
    row.innerHTML = `
      <input type="radio" name="alternativaCorreta" value="${idx}" class="alt-radio" required/>
      <input type="text" name="alternativas" placeholder="Alternativa ${idx + 1}" required/>
      <button type="button" class="btn btn-danger btn-sm remove-alt">✕</button>
    `;
    list.appendChild(row);
    attachRemoveHandler(row.querySelector('.remove-alt'));
    updateRemoveVisibility();
  });

  // Re-numera os values dos rádios antes de enviar, para refletir a ordem atual
  document.getElementById('questao-form').addEventListener('submit', () => {
    list.querySelectorAll('.form-row').forEach((row, idx) => {
      row.querySelector('.alt-radio').value = idx;
    });
  });

  updateRemoveVisibility();
</script>
</body></html>
