<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"/><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.css"></head>
<body>
<div class="page-wrapper">
  <nav class="navbar">
    <a href="/feed" class="navbar-brand">🎯 QuizMaster</a>
    <div class="navbar-nav">
      <a href="/admin">Dashboard</a><a href="/admin/usuarios" class="active">Usuários</a>
      <a href="/admin/quizzes">Quizzes</a><a href="/admin/temas">Temas</a><a href="/logout">Sair</a>
    </div>
  </nav>
  <div class="page-header"><h1>👥 Gerenciar Usuários</h1><p>Total: <%= users.length %> usuário(s)</p></div>
  <div class="table-wrapper">
    <table>
      <thead><tr><th>ID</th><th>Usuário</th><th>Nome</th><th>E-mail</th><th>Cadastrado</th></tr></thead>
      <tbody>
        <% users.forEach(u=>{ %>
        <tr><td>#<%= u.id %></td><td><strong><%= u.username %></strong></td><td><%= u.fullName || '—' %></td><td><%= u.email %></td><td><%= new Date(u.createdAt).toLocaleDateString('pt-BR') %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
</body></html>