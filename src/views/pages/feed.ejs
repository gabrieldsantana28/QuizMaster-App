<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title><%= title %> — QuizMaster</title><link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
<div class="page-wrapper">
  <nav class="navbar">
    <a href="/feed" class="navbar-brand">🎯 QuizMaster</a>
    <div class="navbar-nav">
      <a href="/feed" class="active">Explorar</a>
      <a href="/quiz/criar">+ Criar Quiz</a>
      <a href="/favoritos">❤️ Favoritos</a>
      <% if(user && user.isAdmin){ %><a href="/admin">⚙️ Admin</a><% } %>
      <span class="navbar-user">Olá, <strong><%= user ? user.username : '' %></strong></span>
      <a href="/logout">Sair</a>
    </div>
  </nav>

  <% if(messages && messages.success && messages.success.length){ %><div class="alert alert-success">✅ <%= messages.success[0] %></div><% } %>
  <% if(messages && messages.error && messages.error.length){ %><div class="alert alert-danger">⚠️ <%= messages.error[0] %></div><% } %>

  <div class="flex-between mb-4">
    <div class="page-header" style="margin:0"><h1>📚 Explorar Quizzes</h1></div>
    <a href="/quiz/criar" class="btn btn-primary btn-sm">+ Criar Quiz</a>
  </div>

  <form method="GET" action="/feed" style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:24px">
    <select name="temaId" style="width:auto;padding:9px 14px">
      <option value="">Todos os Temas</option>
      <% if(typeof temas !== 'undefined'){ temas.forEach(t=>{ %>
        <option value="<%= t.id %>" <%= (filtros && filtros.temaId == t.id) ? 'selected' : '' %>><%= t.icone %> <%= t.nome %></option>
      <% }) } %>
    </select>
    <select name="dificuldade" style="width:auto;padding:9px 14px">
      <option value="">Qualquer Dificuldade</option>
      <option value="facil" <%= (filtros && filtros.dificuldade==='facil') ? 'selected':'' %>>🟢 Fácil</option>
      <option value="medio" <%= (filtros && filtros.dificuldade==='medio') ? 'selected':'' %>>🟡 Médio</option>
      <option value="dificil" <%= (filtros && filtros.dificuldade==='dificil') ? 'selected':'' %>>🔴 Difícil</option>
    </select>
    <button type="submit" class="btn btn-secondary btn-sm">Filtrar</button>
    <a href="/feed" class="btn btn-secondary btn-sm">Limpar</a>
  </form>

  <% if(typeof quizzes !== 'undefined' && quizzes.length > 0){ %>
  <div class="card-grid">
    <% quizzes.forEach(function(q){ %>
    <a href="/quiz/<%= q.id %>" class="card-link">
      <div class="card">
        <div class="card-title"><%= q.titulo %></div>
        <div class="card-desc"><%= q.descricao || 'Sem descrição.' %></div>
        <div class="card-meta">
          <span class="dificuldade-<%= q.dificuldade %>">● <%= q.dificuldade %></span>
          <span>👥 <%= q.totalParticipantes || 0 %> jogadores</span>
        </div>
        <div style="margin-top:12px">
          <form method="POST" action="/quiz/<%= q.id %>/favoritar" onclick="event.stopPropagation()">
            <button type="submit" class="btn btn-sm" style="background:none;border:1px solid #334155;color:var(--text-muted);padding:5px 10px;cursor:pointer">❤️ Favoritar</button>
          </form>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <h2>Nenhum quiz encontrado</h2>
    <p>Seja o primeiro a criar um quiz!</p>
    <a href="/quiz/criar" class="btn btn-primary mt-4">+ Criar Quiz</a>
  </div>
  <% } %>
</div>
</body></html>